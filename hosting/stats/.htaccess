# 공통 코드·표 정의·내려받은 국가 DB 파일은 웹으로 열 수 없게
<FilesMatch "^(lib\.php|schema\.sql)$|\.(bak|old|orig|save|swp|tmp)$|~$">
  Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(lib\.php|schema\.sql)$|\.(bak|old|orig|save|swp|tmp)$|~$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
RedirectMatch 404 /_data(/.*)?$

# ── PHP2Shell(CVE-2026-109618·109619·115560, 2026-10) 대비 ──
# 알려진 공격은 모두 '파일 올리기' 형식(multipart/form-data) 요청으로 PHP 내부를 건드린다. 우리 PHP 는
# 이 형식을 받을 일이 없다(방문 통계 = 글자, 국가 DB 갱신 = 보통 폼) — 웹 서버 앞단에서 아예 돌려보낸다.
# 하위 폴더는 위 폴더의 규칙을 늘 물려받지 않으므로 여기에도 둔다.
# 근본 해결은 카페24 PHP 를 패치된 버전(8.2.35·8.3.36·8.4.27·8.5.12 이상)으로 쓰는 것이다.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Content-Type} multipart/ [NC]
  RewriteRule ^ - [F]
</IfModule>
